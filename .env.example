# 知天后端环境变量模板
# 复制为本地 .env 后逐项替换所有 CHANGE_ME_* 占位符；本文件不得填写或提交真实密钥。

# ===== LLM、超时与服务生命周期 =====

# DeepSeek API密钥；字符串，由DeepSeek控制台签发。
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY

# 用户个人DeepSeek Key的AES-256-GCM主加密密钥；URL-safe Base64编码的32字节随机值。
# 生成示例：python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 必须与BACKUP_ENCRYPTION_KEY、JWT密钥和企业密码种子分别生成、分别轮换；丢失后已保存的个人Key无法解密。
PERSONAL_DEEPSEEK_KEY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# DeepSeek兼容API根地址；HTTPS URL，不带具体接口路径。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# fast模式使用的DeepSeek模型标识；填写服务商实际支持的模型名。
DEEPSEEK_FAST_MODEL=CHANGE_ME_FAST_MODEL_NAME

# expert模式使用的DeepSeek模型标识；填写服务商实际支持的模型名。
DEEPSEEK_EXPERT_MODEL=CHANGE_ME_EXPERT_MODEL_NAME

# fast档单次LLM调用超时；正数，单位秒。
FAST_LLM_TIMEOUT=10.0

# expert档普通LLM调用超时；正数，单位秒。
EXPERT_LLM_TIMEOUT=25.0

# expert复杂任务LLM调用超时；正数，单位秒。
EXPERT_COMPLEX_TIMEOUT=120.0

# 流式回答与搜索整理首个正文chunk的统一墙钟上界；正数，单位秒；45.0为按Cloudflare首字节与生产总预算倒推的暂定值，待生产实测复核。
FIRST_CONTENT_TIMEOUT=45.0

# fast档LLM超时后的重试次数；非负整数。
FAST_LLM_TIMEOUT_RETRIES=1

# fast档LLM重试前等待时间；非负数，单位秒。
FAST_LLM_RETRY_DELAY=0.75

# fast模式整个请求的时间预算；正数，单位秒。
FAST_REQUEST_TIMEOUT=25.0

# 联网搜索完整流程的总时间预算；正数，单位秒。
SEARCH_TOTAL_TIMEOUT=30.0

# 联网搜索查询改写的超时；正数，单位秒。
SEARCH_QUERY_REWRITE_TIMEOUT=4.0

# 输出异常观察调用的超时；正数，单位秒。
OUTPUT_ANOMALY_CHECK_TIMEOUT=5.0

# Uvicorn优雅退出等待时间；正数，单位秒。
SHUTDOWN_GRACE_PERIOD_SECONDS=30.0

# SSE无数据期间的心跳间隔；正数，单位秒。
SSE_HEARTBEAT_INTERVAL_SECONDS=15.0

# 异步入库任务状态的轮询间隔；正数，单位秒。
TASK_PROGRESS_POLL_SECONDS=0.5

# 后端监听端口；十进制整数。
# 待完成任务：此变量仅对python main.py直接启动有效。Docker容器环境下Dockerfile固定使用8000端口，Compose部署时修改此值不会改变实际监听端口
PORT=8000

# ===== 认证、跨域与外部服务 =====

# JWT HS256签名密钥；至少32字节高熵随机字符串，不得复用其他密码。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# 历史全局限流值；正整数。
# 待完成任务：此变量当前不生效。RATE_LIMIT_PER_MINUTE实际限流读取SQLite的rate_limit_config表，此环境变量目前不决定任何角色限流值，保留仅为历史兼容，如需调整限流请使用管理后台的限流配置功能
RATE_LIMIT_PER_MINUTE=20

# 允许的前端Origin白名单；多个Origin使用英文逗号分隔，不带路径。
# file://协议或桌面壳本地调试可按需包含null。
# 生产环境部署时CORS_ORIGINS应改为实际管理后台域名，不应包含null。
CORS_ORIGINS=CHANGE_ME_CORS_ORIGINS_WITHOUT_NULL

# 历史兼容的二级开发者密码配置；当前没有端点消费，保留期间仍不得使用弱口令或复用其他密钥。
# 如后续重新启用，可生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
SECONDARY_DEV_PASSWORD=CHANGE_ME_RANDOM_SECRET

# 企业每日密码的确定性推导种子；至少32字节高熵随机字符串，不得与JWT密钥相同。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENTERPRISE_PASSWORD_SEED=CHANGE_ME_RANDOM_SECRET

# 阿里云DirectMail AccessKey ID；仅授予发送邮件所需的最小权限。
ALIYUN_ACCESS_KEY_ID=CHANGE_ME_DIRECTMAIL_ACCESS_KEY_ID

# 阿里云DirectMail AccessKey Secret；不得写入日志、镜像或Git。
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME_DIRECTMAIL_ACCESS_KEY_SECRET

# 阿里云DirectMail区域标识；填写账号实际开通区域对应的region字符串。
ALIYUN_MAIL_REGION_ID=CHANGE_ME_DIRECTMAIL_REGION_ID

# DirectMail已验证的发件地址；邮箱格式，不得使用未验证或个人收件邮箱。
ALIYUN_MAIL_ACCOUNT_NAME=CHANGE_ME_VERIFIED_SENDER_EMAIL

# ===== 文档与工具限制 =====

# 单文件上传体积上限；正整数，单位MiB。
MAX_UPLOAD_SIZE_MB=5

# 单文档允许写入向量库的最大切片数；正整数。
MAX_DOCUMENT_CHUNKS=2000

# 重型任务的全局并发上限；正整数，至少为1。
MAX_CONCURRENT_HEAVY_TASKS=4

# 单账号同时在途的重型任务上限；正整数，至少为1，且必须严格小于全局并发上限。
# 启动陷阱：若此值大于或等于MAX_CONCURRENT_HEAVY_TASKS，config.py会在模块导入时抛出RuntimeError，容器直接拒绝启动；调低全局值时必须同步调低此值，例如全局为2而此值仍为2时服务无法启动。
MAX_USER_INFLIGHT_HEAVY_TASKS=2

# 文档入库任务的全局并发上限；正整数，至少为1。
MAX_CONCURRENT_INGEST_TASKS=2

# 文档入库等待队列深度；整数，运行时会被钳到不小于MAX_CONCURRENT_INGEST_TASKS。
MAX_INGEST_QUEUE_DEPTH=8

# 文档预览最多返回的字符数；正整数。
PREVIEW_MAX_CHARS=20000

# PDF合并一次允许的最大文件数；正整数。
PDF_MERGE_MAX_FILES=10

# PDF拆分一次允许处理的最大页数；正整数。
PDF_SPLIT_MAX_PAGES=200

# 单个聊天附件注入模型上下文的最大字符数；正整数。
CHAT_ATTACHMENT_MAX_CHARS=50000

# 聊天附件临时记录的有效时间；正整数，单位分钟。
CHAT_ATTACHMENT_TTL_MINUTES=30

# LibreOffice单次格式转换超时；正整数，单位秒。
CONVERSION_TIMEOUT_SECONDS=30

# LibreOffice soffice可执行文件绝对路径；Windows与Linux路径格式不同，Compose会固定覆盖为容器内路径。
LIBREOFFICE_PATH=CHANGE_ME_SOFFICE_ABSOLUTE_PATH

# expert复杂任务历史累计任务数量上限；正整数。
MAX_COMPLEX_TASKS=10

# ===== 检索与模型资产 =====

# Tavily联网检索API密钥；字符串，由Tavily控制台签发。
TAVILY_API_KEY=CHANGE_ME_TAVILY_API_KEY

# 联网搜索提供方标识；当前只支持tavily。
WEB_SEARCH_PROVIDER=tavily

# BGE ONNX嵌入模型目录；绝对路径，目录内须包含项目要求的模型资产。
EMBEDDING_MODEL_DIR=CHANGE_ME_EMBEDDING_MODEL_DIRECTORY

# RAG候选接受阈值；0到1之间的小数。
RAG_SCORE_THRESHOLD=0.55

# BM25分数归一化缩放系数；正数。
BM25_SCORE_SCALE=20.0

# 标题补充召回允许的最大查询长度；正整数，单位字符。
TITLE_BOOST_MAX_QUERY_LENGTH=12

# 是否启用DeepSeek候选重排序；布尔字符串true或false。
RERANK_ENABLED=true

# 进入重排序的最大候选数量；正整数。
RERANK_CANDIDATE_COUNT=10

# 文档精排模型调用超时；正数，单位秒；12.0为本机实测暂定值，待生产实测复核。
RERANK_TIMEOUT=12.0

# ===== 长期记忆 =====

# 进入长期记忆判断的最短消息长度；非负整数，单位字符。
MEMORY_MIN_LENGTH=6

# 长期记忆重要性判断调用超时；正数，单位秒。
MEMORY_IMPORTANCE_TIMEOUT=3.0

# 高重要性记忆的衰减半衰期；正整数，单位天。
MEMORY_DECAY_HALFLIFE_HIGH_DAYS=90

# 普通记忆的衰减半衰期；正整数，单位天。
MEMORY_DECAY_HALFLIFE_NORMAL_DAYS=14

# 高重要性记忆停止参与检索的年龄阈值；正整数，单位天。
MEMORY_FADE_OUT_HIGH_DAYS=365

# 普通记忆停止参与检索的年龄阈值；正整数，单位天。
MEMORY_FADE_OUT_NORMAL_DAYS=60

# 高重要性记忆允许物理清理的年龄阈值；正整数，单位天。
MEMORY_HARD_DELETE_HIGH_DAYS=540

# 普通记忆允许物理清理的年龄阈值；正整数，单位天。
MEMORY_HARD_DELETE_NORMAL_DAYS=90

# ===== GraphRAG =====

# 是否启用GraphRAG建图与图扩展；布尔字符串true或false。
GRAPH_RAG_ENABLED=false

# 图扩展后候选数量相对原候选数量的最大倍数；不小于1的数字。
GRAPH_EXPANSION_MAX_MULTIPLIER=2.0

# 文档入库时实体关系抽取超时；正数，单位秒。
GRAPH_EXTRACTION_TIMEOUT=20.0

# 图关系传播分相对种子分的衰减系数；0到1之间的小数。
GRAPH_PROPAGATION_DECAY=0.85

# ===== 进程内加密备份调度 =====

# 是否启动随应用进程运行的每日加密备份；布尔字符串true或false。
# 正式Compose部署已显式设为true，直接运行main.py与测试环境默认保持false。
SCHEDULED_BACKUP_ENABLED=false

# 加密归档输出目录；必须位于业务data目录之外，Compose使用独立具名卷/app/backups。
SCHEDULED_BACKUP_PATH=CHANGE_ME_ABSOLUTE_BACKUP_PATH

# 每日备份触发时刻；严格使用HH:MM，按代码内显式UTC+8解释，不依赖容器TZ。
SCHEDULED_BACKUP_LOCAL_TIME=00:00

# 进程内加密归档保留份数；正整数，生产默认3且代码保证至少保留1份。
SCHEDULED_BACKUP_RETENTION=3

# ===== 手工加密备份 =====

# 备份包AES-256-GCM加密密钥；URL-safe Base64编码的32字节随机值。
# 生成示例：python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 密钥丢失后既有备份无法恢复；不得与JWT密钥或企业密码种子复用。
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# 数据路径说明（当前不是环境变量）：
# users.db、history.db、files.db、Chroma vectordb与user_files均位于项目data/目录；
# Docker Compose中统一持久化到/app/data具名卷。不要自行添加代码不识别的路径变量。
